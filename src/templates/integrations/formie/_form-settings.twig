{% import '_includes/forms' as forms %}
{% import 'verbb-base/_macros' as macros %}

{% set handle = integration.handle %}
{% set displayName = integration.displayName() %}
{% set formSettings = integration.getFormSettings().getSettings() %}

{% set mapToContacts = form.settings.integrations[handle].mapToContacts ?? '' %}
{% set mapToCompanies = form.settings.integrations[handle].mapToCompanies ?? '' %}
{% set mapToDeals = form.settings.integrations[handle].mapToDeals ?? '' %}
{% set linkToCompany = form.settings.integrations[handle].linkToCompany ?? '' %}
{% set dealTitle = form.settings.integrations[handle].dealTitle ?? '' %}

<field-select
    label="{{ 'Opt-In Field'|t('formie') }}"
    instructions="{{ 'Choose a field to opt-in to {name}. For example, you might only wish to record user data if they provide a value for a field of your choice - commonly, an Agree field.' | t('formie', { name: displayName }) }}"
    id="opt-in-field"
    name="optInField"
    :value="get(form, 'settings.integrations.{{ handle }}.optInField')"
></field-select>

<hr>

<integration-form-settings handle="{{ handle }}" :form-settings="{{ formSettings | json_encode }}">
    <template v-slot="{ get, isEmpty, input, settings, sourceId, loading, refresh, error, errorMessage, getSourceFields }">
        <div class="field">
            <button class="btn" :class="{ 'fui-loading fui-loading-sm': loading }" data-icon="refresh" @click.prevent="refresh">
                {{ 'Refresh Integration' | t('formie') }}
            </button>
        </div>

        <div v-if="error" class="error" style="margin-top: 10px;" v-cloak>
            <span data-icon="alert"></span>
            <span v-html="errorMessage"></span>
        </div>

        {{ forms.lightswitchField({
            label: 'Map to Contacts'|t('formie'),
            instructions: 'Whether to map form data to {name} {label}.' | t('formie', { name: displayName, label: 'Contacts' }),
            id: 'mapToContacts',
            name: 'mapToContacts',
            on: mapToContacts,
            toggle: 'map-to-contacts',
        }) }}

        <div id="map-to-contacts" class="{{ not mapToContacts ? 'hidden' }}">
            <integration-field-mapping
                label="{{ 'Contacts Field Mapping' | t('formie') }}"
                instructions="{{ 'Choose how your form fields should map to your {name} {label} fields.' | t('formie', { name: displayName, label: 'Contacts' }) }}"
                name-label="{{ integration.displayName() }}"
                id="contacts-field-mapping"
                name="contactsFieldMapping"
                :value="get(form, 'settings.integrations.{{ handle }}.contactsFieldMapping')"
                :rows="get(settings, 'contacts')"
            ></integration-field-mapping>

            <ul v-if="!isEmpty(get(form, 'settings.integrations.{{ handle }}.errors.contactsFieldMapping'))" class="errors" v-cloak>
                <li v-for="(error, index) in get(form, 'settings.integrations.{{ handle }}.errors.contactsFieldMapping')" :key="index">
                    ${ error }
                </li>
            </ul>

            {{ forms.lightswitchField({
                label: 'Append Tags' | t('formie'),
                id: 'appendTags',
                name: 'appendTags',
                instructions: 'Whether to append tags to the list of existing member tags.' | t('formie'),
                on: form.settings.integrations[handle].appendTags ?? false,
            }) }}
        </div>

        {{ forms.lightswitchField({
            label: 'Map to Companies'|t('formie'),
            instructions: 'Whether to map form data to {name} {label}.' | t('formie', { name: displayName, label: 'Companies' }),
            id: 'mapToCompanies',
            name: 'mapToCompanies',
            on: mapToCompanies,
            toggle: 'map-to-companies',
        }) }}

        <div id="map-to-companies" class="{{ not mapToCompanies ? 'hidden' }}">
            {{ forms.lightswitchField({
                label: 'Link user to company'|t('formie'),
                instructions: 'Whether the user should be linked to the created company.' | t('formie', { name: displayName }),
                id: 'linkToCompany',
                name: 'linkToCompany',
                on: linkToCompany,
            }) }}

            <integration-field-mapping
                label="{{ 'Companies Field Mapping' | t('formie') }}"
                instructions="{{ 'Choose how your form fields should map to your {name} {label} fields.' | t('formie', { name: displayName, label: 'Contacts' }) }}"
                name-label="{{ integration.displayName() }}"
                id="companies-field-mapping"
                name="companiesFieldMapping"
                :value="get(form, 'settings.integrations.{{ handle }}.companiesFieldMapping')"
                :rows="get(settings, 'companies')"
            ></integration-field-mapping>

            <ul v-if="!isEmpty(get(form, 'settings.integrations.{{ handle }}.errors.companiesFieldMapping'))" class="errors" v-cloak>
                <li v-for="(error, index) in get(form, 'settings.integrations.{{ handle }}.errors.companiesFieldMapping')" :key="index">
                    ${ error }
                </li>
            </ul>
        </div>

        {{ forms.lightswitchField({
            label: 'Map to Deals' | t('formie'),
            instructions: 'Whether to map form data to {name} {label}.' | t('formie', { name: displayName, label: 'Deals' }),
            id: 'mapToDeals',
            name: 'mapToDeals',
            on: mapToDeals,
            toggle: 'map-to-deals',
        }) }}

        <div id="map-to-deals" class="{{ not mapToDeals ? 'hidden' }}">

            {{ forms.textField({
                label: 'Deal Title' | t('formie'),
                instructions: 'Enter a title to use for the created deal.' | t('formie'),
                name: 'dealTitle',
                required: true,
                value: dealTitle,
            }) }}

            <integration-field-mapping
                label="{{ 'Deals Field Mapping' | t('formie') }}"
                instructions="{{ 'Choose how your form fields should map to your {name} {label} fields.' | t('formie', { name: displayName, label: 'Deals' }) }}"
                name-label="{{ integration.displayName() }}"
                id="deals-field-mapping"
                name="dealsFieldMapping"
                :value="get(form, 'settings.integrations.{{ handle }}.dealsFieldMapping')"
                :rows="get(settings, 'deals')"
            ></integration-field-mapping>

            <ul v-if="!isEmpty(get(form, 'settings.integrations.{{ handle }}.errors.dealsFieldMapping'))" class="errors" v-cloak>
                <li v-for="(error, index) in get(form, 'settings.integrations.{{ handle }}.errors.dealsFieldMapping')" :key="index">
                    ${ error }
                </li>
            </ul>
        </div>
    </template>
</integration-form-settings>
