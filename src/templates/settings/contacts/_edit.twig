{% requirePermission "teamleader-focus:settings" %}

{% extends "teamleader-focus/_layouts/teamleader-cp-settings.twig" %}
{% import '_includes/forms.twig' as forms %}

{% set tabs = {
    fieldLayout: { label: 'Contact Fields'|t('teamleader-focus'), url: '#fieldlayout' },
} %}

{% block actionButton %}
    <input type="submit" class="btn submit" value="{{ 'Save'|t('app') }}">
{% endblock %}

{% block content %}
    <input type="hidden" name="action" value="teamleader-focus/settings/save-contact-settings">
    <input type="hidden" name="pluginHandle" value="teamleader-focus">

    <div id="fieldlayout" class="flex-fields">
        {{ forms.fieldLayoutDesignerField({
            fieldLayout: fieldLayout,
        }) }}
    </div>
{% endblock %}
