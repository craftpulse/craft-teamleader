{% requirePermission "teamleader-focus:settings" %}

{% extends "teamleader-focus/_layouts/teamleader-cp-settings.twig" %}
{% import '_includes/forms.twig' as forms %}
{% from 'teamleader-focus/_macros' import instructions %}

{% set tabs = {
    api: { label: 'Teamleader Focus API'|t('teamleader-focus'), url: '#api' },
    general: { label: 'General'|t('teamleader-focus'), url: '#general' },
} %}

{% block actionButton %}
    <input type="submit" class="btn submit" value="{{ 'Save'|t('app') }}">
{% endblock %}

{% block content %}
    <input type="hidden" name="action" value="teamleader-focus/settings/save">
    <input type="hidden" name="pluginHandle" value="teamleader-focus">

    <div id="api" class="flex-fields">
        <div class="flex field">
            <div class="flex-grow">
                {{ forms.autosuggestField({
                    label: 'Client ID.'|t('teamleader-focus'),
                    instructions: "Enter your Teamleader Focus client ID here."|t('teamleader-focus'),
                    name: 'settings[clientId]',
                    suggestEnvVars: true,
                    value: settings.clientId,
                    required: true,
                }) }}

                {{ forms.autosuggestField({
                    label: 'Client Secret.'|t('teamleader-focus'),
                    instructions: "Enter your Teamleader Focus client secret here."|t('teamleader-focus'),
                    name: 'settings[clientSecret]',
                    suggestEnvVars: true,
                    value: settings.clientSecret,
                    required: true,
                }) }}

                {%- if settings.clientSecret and settings.clientId -%}
                    <div class="field">
                        <div class="heading">
                            <label>
                                Connection
                            </label>
                        </div>
                        <div class="instructions tw-mb-1">
                            <p>
                                {{ 'The connection status. Connect or disconnected from your Teamleader Focus platform.'|t }}
                            </p>
                        </div>
                        {%- if connected -%}
                            <div class="flex tw-gap-2">
                                <div class="status enabled"></div> <span>{{ 'Connected'|t('teamleader-focus') }}</span>
                                <div class="input ltr">
                                    <a class="btn small formsubmit" data-action="teamleader-focus/auth/disconnect">
                                        {{ 'Disconnect'|t('teamleader-focus') }}
                                    </a>
                                </div>
                            </div>

                        {%- else -%}
                            <div class="flex tw-gap-2">
                                <div class="status disabled"></div> <span>{{ 'Not connected'|t('teamleader-focus') }}</span>
                                <div class="input ltr">
                                    <a class="btn small formsubmit" data-action="teamleader-focus/auth/connect">
                                        {{ 'Connect'|t('teamleader-focus') }}
                                    </a>
                                </div>
                            </div>
                        {%- endif -%}
                    </div>
                {%- endif -%}
            </div>
        </div>
    </div>

    <div id="general" class="hidden flex-fields">
        <div class="flex field">
            <div class="flex-grow">
                {% set info %}
                    {{ 'With this setting enabled, the elements will display the custom fields made in Teamleader Focus.'|t('teamleader-focus') }}
                {% endset %}
                {{ forms.lightswitchField({
                    label: "Synchronize custom fields"|t('teamleader-focus'),
                    instructions: instructions("Whether custom fields should be displayed.", info),
                    name: 'settings[syncCustomFields]',
                    on: settings.syncCustomFields,
                }) }}
            </div>
        </div>
    </div>
{% endblock %}

{#
{% set instructions %}
    ### Step 1. Connect to the {name} API
    1. Go to <a href="https://focus.teamleader.eu/oauth2/authorize" target="_blank">{name}</a> and login to your account.
    2. Go to <a href="https://marketplace.teamleader.eu/be/en/build/integrations" target="_blank">Build an integration</a> and click "Create New Integration"
    3. Follow the steps and fill in the required fields
    4. Make sure the following OAuth scopes are selected:
    - Companies
    - Contacts
    - Deals
    5. Click the **Save Changes** button at the end of the form
    6. Once created copy the **Client ID** and the **Client Secret** from {name} and paste in the fields below.

    ### Step 2. Test Connection
    1. Save this integration.
    2. Click on the **Refresh** button in the right-hand sidebar.
{% endset %} #}
